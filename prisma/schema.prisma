// Diviyata Sawiyak database schema. Section 5 of docs/SPEC.md describes each entity.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// Kind of help (SPEC section 5). Land-only cases are out of scope.
enum Kind {
  NEW_HOUSE
  RENOVATION
}

model Province {
  id        Int        @id @default(autoincrement())
  nameEn    String     @unique @map("name_en")
  nameSi    String     @unique @map("name_si")
  districts District[]

  @@map("province")
}

model District {
  id         Int        @id @default(autoincrement())
  nameEn     String     @unique @map("name_en")
  nameSi     String     @unique @map("name_si")
  provinceId Int        @map("province_id")
  province   Province   @relation(fields: [provinceId], references: [id])
  dsOffices  DsOffice[]

  @@index([provinceId])
  @@map("district")
}

/// A Divisional Secretariat. Never deleted: inactive offices keep their accounts and cases (LST-3).
model DsOffice {
  id         Int      @id @default(autoincrement())
  /// Three capital letters, unique nationally, used in case numbers (CASE-5).
  code       String   @unique @db.Char(3)
  nameEn     String   @map("name_en")
  nameSi     String   @map("name_si")
  districtId Int      @map("district_id")
  district   District @relation(fields: [districtId], references: [id])
  active     Boolean  @default(true)
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@unique([districtId, nameSi])
  @@index([districtId])
  @@map("ds_office")
}

/// Building stages per kind of help (LST-4). A used stage is deactivated, never removed.
model StageDefinition {
  id        Int      @id @default(autoincrement())
  kind      Kind
  sortOrder Int      @map("sort_order")
  nameSi    String   @map("name_si")
  active    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([kind, nameSi])
  @@index([kind, sortOrder])
  @@map("stage_definition")
}

/// Append-only history of every change (HIS-1). The app's database role may only insert and read (HIS-3, Phase 2).
model AuditLog {
  id         BigInt   @id @default(autoincrement())
  at         DateTime @default(now())
  /// The signed-in user; empty for system actions such as the seed.
  actorId    String?  @map("actor_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String   @map("entity_id")
  caseId     String?  @map("case_id")
  before     Json?
  after      Json?

  @@index([entityType, entityId])
  @@index([caseId])
  @@index([at])
  @@map("audit_log")
}
